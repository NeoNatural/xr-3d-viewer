<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:horizonos="http://schemas.horizonos/sdk">

    <!-- The OpenXR loader declares minSdk 24 but is only ever loaded on
         headsets, so the app wide minSdk 21 remains safe -->
    <uses-sdk tools:overrideLibrary="org.khronos.openxr.openxr_loader_for_android" />

    <!-- So the bug report screen can tell whether this device has an email
         app at all before offering to send by one -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <!-- Horizon OS refuses to route immersive frames for apps that do not
         declare an HzOS SDK version since around the v77 update. Other
         platforms ignore this namespace entirely -->
    <horizonos:uses-horizonos-sdk
        horizonos:minSdkVersion="77"
        horizonos:targetSdkVersion="77" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAPTURE_KEYBOARD" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="false" />

    <!-- Disable legacy input emulation on ChromeOS -->
    <uses-feature
        android:name="android.hardware.type.pc"
        android:required="false"/>

    <!-- VR headsets. Optional so phones and TVs are unaffected -->
    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:version="1"
        android:required="false"/>
    <!-- Meta gates the passthrough cameras on this. Not required, since the
         other headset does passthrough as a blend mode instead -->
    <uses-feature
        android:name="com.oculus.feature.PASSTHROUGH"
        android:required="false"/>
    <!-- Hand tracking. Meta wants the feature and the permission together, and
         Pico reads its own key. All optional: controllers still work without -->
    <uses-feature
        android:name="oculus.software.handtracking"
        android:required="false"/>
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />
    <uses-feature
        android:name="pvr.software.handtracking"
        android:required="false"/>
    <!-- Eye tracking, for headsets that point by looking. Optional again, and
         only ever used to aim the existing pointer -->
    <uses-feature
        android:name="oculus.software.eye_tracking"
        android:required="false"/>
    <uses-permission android:name="com.oculus.permission.EYE_TRACKING" />
    <uses-feature
        android:name="pvr.software.eyetracking"
        android:required="false"/>
    <uses-permission android:name="com.picovr.permission.EYE_TRACKING" />

    <application
        android:name=".MoonlightApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/backup_rules_s"
        android:networkSecurityConfig="@xml/network_security_config"
        android:banner="@drawable/atv_banner"
        android:appCategory="video"
        android:icon="@mipmap/ic_launcher"
        android:installLocation="auto"
        android:gwpAsanMode="always"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="false"
        android:theme="@style/AppTheme">

        <!-- Pico classifies the whole app from this. The 2d activities
             override it individually below -->
        <meta-data
            android:name="pvr.app.type"
            android:value="vr" />
        <!-- Meta Quest device gate for the VR activity -->
        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest2|questpro|quest3" />

        <!-- Samsung multi-window support -->
        <uses-library
            android:name="com.sec.android.app.multiwindow"
            android:required="false" />
        <meta-data
            android:name="com.sec.android.support.multiwindow"
            android:value="true" />

        <!-- Samsung DeX support requires explicit placement of android:resizeableActivity="true"
             in each activity even though it is implied by targeting API 24+ -->

        <activity
            android:name=".PcView"
            android:exported="true"
            android:resizeableActivity="true"
            android:enableOnBackInvokedCallback="true"
            android:configChanges="mcc|mnc|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|screenSize|smallestScreenSize|layoutDirection">

            <meta-data android:name="WindowManagerPreference:FreeformWindowSize" android:value="system-default" />
            <meta-data android:name="WindowManagerPreference:FreeformWindowOrientation" android:value="landscape" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.MULTIWINDOW_LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="tv.ouya.intent.category.APP" />
            </intent-filter>
            <meta-data android:name="pvr.app.type" android:value="2d" />
        </activity>
        <activity
            android:name=".preferences.StreamSettings"
            android:resizeableActivity="true"
            android:enableOnBackInvokedCallback="true"
            android:configChanges="mcc|mnc|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|screenSize|smallestScreenSize|layoutDirection"
            android:label="Media Settings">
            <meta-data android:name="WindowManagerPreference:FreeformWindowSize" android:value="system-default" />
            <meta-data android:name="WindowManagerPreference:FreeformWindowOrientation" android:value="landscape" />
            <meta-data android:name="pvr.app.type" android:value="2d" />
        </activity>
        <activity
            android:name=".LegalNoticesActivity"
            android:exported="false"
            android:label="@string/title_legal_notices"
            android:resizeableActivity="true">
            <meta-data android:name="pvr.app.type" android:value="2d" />
        </activity>
        <activity
            android:name=".local.LocalBrowserActivity"
            android:resizeableActivity="true"
            android:enableOnBackInvokedCallback="false"
            android:exported="false">
            <meta-data android:name="pvr.app.type" android:value="2d" />
        </activity>
        <activity
            android:name=".smb.SmbBrowserActivity"
            android:resizeableActivity="true"
            android:enableOnBackInvokedCallback="false"
            android:exported="false">
            <meta-data android:name="pvr.app.type" android:value="2d" />
        </activity>

        <activity
            android:name=".StaticImageXrActivity"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|screenSize|smallestScreenSize|layoutDirection"
            android:noHistory="true"
            android:resizeableActivity="false"
            android:enableOnBackInvokedCallback="false"
            android:excludeFromRecents="true"
            android:theme="@style/StreamTheme"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
            <meta-data android:name="pvr.app.type" android:value="vr" />
        </activity>

        <activity
            android:name=".VideoXrActivity"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|screenSize|smallestScreenSize|layoutDirection"
            android:noHistory="true"
            android:resizeableActivity="false"
            android:enableOnBackInvokedCallback="false"
            android:excludeFromRecents="true"
            android:theme="@style/StreamTheme"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
            <meta-data android:name="pvr.app.type" android:value="vr" />
        </activity>

        <activity
            android:name=".BugReportActivity"
            android:resizeableActivity="true"
            android:enableOnBackInvokedCallback="true"
            android:label="@string/title_bug_report"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="mcc|mnc|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|screenSize|smallestScreenSize|layoutDirection">
            <meta-data android:name="WindowManagerPreference:FreeformWindowSize" android:value="system-default" />
            <meta-data android:name="WindowManagerPreference:FreeformWindowOrientation" android:value="landscape" />
            <meta-data android:name="pvr.app.type" android:value="2d" />
        </activity>
        <!-- Hands a saved report to the email app the user picks. Not exported:
             the read grant on the send intent is the only way in -->
        <provider
            android:name=".ReportContentProvider"
            android:authorities="report.${applicationId}"
            android:exported="false"
            android:grantUriPermissions="true">
        </provider>
    </application>

</manifest>
