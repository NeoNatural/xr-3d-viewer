    <string name="title_settings_back">返回</string>
    <string name="title_vr_pointer">手柄指针</string>
    <string name="summary_vr_pointer">用手柄指向屏幕，扳机键单击，A 或 X 键右击，摇杆滚动。按下摇杆可关闭指针。</string>
    <string name="title_vr_gaze">视线指向</string>
    <string name="summary_vr_gaze">在支持眼动追踪的头显上，注视屏幕并捏合即可点击。手柄或手指指向屏幕时会接管指针。</string>
    <string name="title_vr_hand_tracking">手部追踪</string>
    <string name="summary_vr_hand_tracking">放下手柄后可用手指向并捏合。关闭后只用手柄。播放时可用银幕左侧的锁暂时禁用手势。</string>
    <string name="title_vr_passthrough">透视环境</string>
    <string name="summary_vr_passthrough">显示周围的真实环境。透视会增加系统负载，播放卡顿时可以关闭。</string>
    <string name="title_vr_depth_source">实时 3D 模式</string>
    <string name="summary_vr_depth_source">选择深度模型、关闭转换或显示测试图案。</string>
    <string name="title_vr_env_res">环境分辨率</string>
    <string name="summary_vr_env_res">设置银幕周围 3D 房间的清晰度。更高画质需要更多 GPU 时间，极高档为实验选项，可能出现卡顿。</string>
    <string name="title_seekbar_vr_inference_cadence">每秒深度更新次数</string>
    <string name="summary_seekbar_vr_inference_cadence">较低的更新率可降低负载，但深度变化会滞后于运动。视频播放跟不上时会暂时降低更新率。</string>
    <string name="suffix_seekbar_vr_inference_cadence">次/秒</string>
    <string name="title_vr_depth_debug">显示深度图</string>
    <string name="summary_vr_depth_debug">用灰度深度图替代视频画面，检查深度质量。</string>
    <string name="title_vr_eye_swap">交换左右眼</string>
    <string name="summary_vr_eye_swap">在立体播放时交换左右眼画面。</string>
    <string name="title_seekbar_vr_separation">立体视差</string>
    <string name="title_vr_file_log">保存日志文件</string>
    <string name="summary_vr_file_log">将文本日志保存在 Download/MoonlightXR，可用头显文件管理器找到并随问题报告发送。单个文件最大 5 MB，会保留上一个文件。重启应用后生效。</string>
    <string name="title_bug_report">反馈问题</string>
    <string name="summary_bug_report">将问题描述、设备、设置和日志整理成报告并发送。</string>
